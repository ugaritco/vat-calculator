{
    "name": "mpociot/vat-calculator",
    "description": "EU VAT calculation, the way it should be.",
    "keywords": [
        "VAT",
        "Tax",
        "EU MOSS",
        "VAT ID",
        "Tax calculation",
        "VAT calculation",
        "Cashier"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Marcel Pociot",
            "email": "m.pociot@gmail.com"
        },
        {
            "name": "Dries Vints",
            "homepage": "https://driesvints.com"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "require": {
        "php": "^7.3|~8.0.0|~8.1.0|~8.2.0|~8.3.0|~8.4.0|~8.5.0",
        "ext-json": "*",
        "ext-soap": "*"
    },
    "require-dev": {
        "heritage/contracts": "^1.00.00",
        "mockery/mockery": "^1.3.3",
        "orchestra/testbench": "^4.0|^5.0|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Mpociot\\VatCalculator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.x-dev"
        },
        "ugarit": {
            "providers": [
                "Mpociot\\VatCalculator\\VatCalculatorServiceProvider"
            ],
            "aliases": {
                "VatCalculator": "Mpociot\\VatCalculator\\Facades\\VatCalculator"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.00.00"
}
